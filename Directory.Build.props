<!--
  Inherited by every project in the repository (src/ and tests/ both sit below this file, and the
  solution is at the root). Do not repeat these properties in individual .csproj files.

  EnforceCodeStyleInBuild is the load-bearing setting: it promotes the IDExxxx style rules from
  .editorconfig into build diagnostics, so gate.ps1's `dotnet build -warnaserror` enforces style
  and analyzers without any extra gate step.

  Deliberately NOT set here: TargetFramework. This repo is deliberately multi-targeted —
  MW3.Core is netstandard2.1 (standing decision S-2 / D-2, so a future Unity migration stays
  possible) while MW3.Game and the platform heads are net10.0 (D-6). Each .csproj declares its own.
-->
<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: missing XML comment on a public member. Documentation file is on for the analyzer
         coverage it unlocks, not to force a doc comment on every property. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Deterministic, reproducible output; fail on a package with a known vulnerability. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>moderate</NuGetAuditLevel>
  </PropertyGroup>

  <!-- Test projects: same strictness, minus the rules that fight normal test code. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests')) OR $(MSBuildProjectName.EndsWith('.IntegrationTests'))">
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
