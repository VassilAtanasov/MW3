<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.*" />
  </ItemGroup>

  <!-- Phase 8 FR-3 (D-74): this head is the composition root. MW3.Game no longer references
       MW3.Core, so the thing that builds the loopback gateway - which needs the rules - has to be
       above it, and the only things above it are the two heads. -->
  <ItemGroup>
    <ProjectReference Include="..\MW3.Game\MW3.Game.csproj" />
    <ProjectReference Include="..\MW3.Core\MW3.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <MonoGameContentReference Include="..\MW3.Game\Content\Content.mgcb" />
  </ItemGroup>

  <!-- D-67: MapPoint, BaseType and the other pure value types live in MW3.Protocol now. A global
       using absorbs the move; MW3.Protocol arrives transitively through MW3.Core. -->
  <ItemGroup>
    <Using Include="MW3.Protocol" />
  </ItemGroup>

</Project>
