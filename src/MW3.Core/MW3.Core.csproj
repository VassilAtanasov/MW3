<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Phase 7 FR-6: TowerThreatEstimator is pure geometry with no public callers, and its
      multi-segment arithmetic is pinned by hand-computed unit tests that need to call it directly.
      Same seam MW3.Game already opens for MW3.Game.Tests; it widens no shipped API surface.
    -->
    <InternalsVisibleTo Include="MW3.Core.Tests" />
    <ProjectReference Include="..\MW3.Protocol\MW3.Protocol.csproj" />
  </ItemGroup>

  <!-- D-67: the value types moved down to MW3.Protocol. A global using absorbs the move so no
       existing file needs a using directive edited into it one at a time. -->
  <ItemGroup>
    <Using Include="MW3.Protocol" />
  </ItemGroup>

</Project>
