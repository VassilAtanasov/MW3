<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-android</TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
    <SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.*">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
    <PackageReference Include="MonoGame.Framework.Android" Version="3.8.*">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Phase 8 FR-3, success criterion 3: there is deliberately NO reference to MW3.Core here. The
       client renders a MatchSnapshot and submits commands through an IMatchGateway; the rules live
       on the far side of that seam, and the missing reference is what makes "the client contains no
       rules" a build error rather than a review opinion (D-57). MW3.Protocol is referenced directly
       now that it no longer arrives transitively through MW3.Core. -->
  <ItemGroup>
    <ProjectReference Include="..\MW3.Protocol\MW3.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets MW3.Game.Tests exercise BaseActionMenu directly - it decides nothing itself (D-25)
         but its own change-detection cache (issue #46) has no other route to a unit test. -->
    <InternalsVisibleTo Include="MW3.Game.Tests" />
  </ItemGroup>

  <!-- D-67: MapPoint, BaseType and the other pure value types live in MW3.Protocol now. A global
       using absorbs the move. -->
  <ItemGroup>
    <Using Include="MW3.Protocol" />
  </ItemGroup>

</Project>
