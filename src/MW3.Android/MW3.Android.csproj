<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <ApplicationId>com.vassilatanasov.mw3</ApplicationId>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <!-- Debug builds default to Fast Deployment: assemblies are pushed to the device separately by
         `dotnet build -t:Run`'s own deploy step rather than embedded in the APK. A plain
         `adb install` of that APK (CI's artifact) then aborts on launch with no assemblies found.
         Embedding keeps the CI-published Debug APK self-contained and installable standalone,
         which is what FR-4 requires (see docs/welcome-screen/ARCHITECTURE.md section 2a). -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.Android" Version="3.8.*" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.*" />
  </ItemGroup>

  <!-- Phase 8 FR-3 (D-74): this head is the composition root, exactly as MW3.Desktop is. FR-5 adds
       the MW3.Transport reference and nothing else (§5: ClientWebSocket and System.Text.Json are
       in-box on net10.0-android, so no NuGet package) - this is FR-5's own reference; #118's
       "both heads reference it" is satisfied by the desktop head alone. -->
  <ItemGroup>
    <ProjectReference Include="..\MW3.Game\MW3.Game.csproj" />
    <ProjectReference Include="..\MW3.Core\MW3.Core.csproj" />
    <ProjectReference Include="..\MW3.Transport\MW3.Transport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <MonoGameContentReference Include="..\MW3.Game\Content\Content.mgcb" />
  </ItemGroup>

  <!-- FR-5, D-84: same logical resource name at every configuration, different content selected by
       $(Configuration) - AndroidManifest.xml references @xml/network_security_config unconditionally.
       The two source files live outside Resources\ so the SDK's default AndroidResource glob never
       picks up both of them; only the one Linked in for this $(Configuration) reaches the APK. -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <AndroidResource Include="NetworkSecurityConfigSources\network_security_config_debug.xml" Link="Resources\xml\network_security_config.xml" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <AndroidResource Include="NetworkSecurityConfigSources\network_security_config_release.xml" Link="Resources\xml\network_security_config.xml" />
  </ItemGroup>

  <!-- D-67: MapPoint, BaseType and the other pure value types live in MW3.Protocol now. A global
       using absorbs the move; MW3.Protocol arrives transitively through MW3.Core. -->
  <ItemGroup>
    <Using Include="MW3.Protocol" />
  </ItemGroup>

</Project>
