<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <ApplicationId>com.vassilatanasov.mw3</ApplicationId>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <!-- Debug builds default to Fast Deployment: assemblies are pushed to the device separately by
         `dotnet build -t:Run`'s own deploy step rather than embedded in the APK. A plain
         `adb install` of that APK (CI's artifact) then aborts on launch with no assemblies found.
         Embedding keeps the CI-published Debug APK self-contained and installable standalone,
         which is what FR-4 requires (see docs/welcome-screen/ARCHITECTURE.md section 2a). -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.Android" Version="3.8.*" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MW3.Game\MW3.Game.csproj" />
  </ItemGroup>

  <ItemGroup>
    <MonoGameContentReference Include="..\MW3.Game\Content\Content.mgcb" />
  </ItemGroup>

  <!-- D-67: MapPoint, BaseType and the other pure value types live in MW3.Protocol now. A global
       using absorbs the move; MW3.Protocol arrives transitively through MW3.Core. -->
  <ItemGroup>
    <Using Include="MW3.Protocol" />
  </ItemGroup>

</Project>
